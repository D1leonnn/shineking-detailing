---
const links = {
  Services: ['Exterior Detailing', 'Interior Cleaning', 'Paint Correction', 'Ceramic Coating'],
  Company:  ['About Us', 'Our Process', 'Gallery', 'Careers'],
  Support:  ['Pricing', 'FAQ', 'Contact', 'Book Online'],
};

const socials = [
  { label: 'Instagram', href: '#', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>` },
  { label: 'Facebook',  href: '#', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>` },
  { label: 'TikTok',    href: '#', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>` },
  { label: 'YouTube',   href: '#', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22.54 6.42A2.78 2.78 0 0020.77 4.6C19.1 4.14 12 4.14 12 4.14s-7.1 0-8.77.46A2.78 2.78 0 001.46 6.42 29.94 29.94 0 001 12a29.94 29.94 0 00.46 5.58 2.78 2.78 0 001.77 1.82C4.9 19.86 12 19.86 12 19.86s7.1 0 8.77-.46a2.78 2.78 0 001.77-1.82A29.94 29.94 0 0023 12a29.94 29.94 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/></svg>` },
];
---

<footer class="footer">
  <div class="footer-top">
    <div class="container">
      <div class="footer-grid">

        <!-- Brand column -->
        <div class="footer-brand">
          <a href="#" class="footer-logo">
            <svg width="28" height="28" viewBox="0 0 100 100" fill="none">
              <path d="M12 56 L22 36 Q28 28 40 28 L60 28 Q72 28 78 36 L88 56 L89 66 Q89 73 83 73 L78 73 Q78 79 72 79 L28 79 Q22 79 22 73 L17 73 Q11 73 11 66 Z" fill="#dc2626"/>
              <path d="M24 49 L30 37 Q33 31 40 31 L60 31 Q67 31 70 37 L76 49 Z" fill="#080808"/>
              <circle cx="30" cy="71" r="8.5" fill="#080808"/>
              <circle cx="30" cy="71" r="4" fill="#dc2626"/>
              <circle cx="70" cy="71" r="8.5" fill="#080808"/>
              <circle cx="70" cy="71" r="4" fill="#dc2626"/>
            </svg>
            <span>PlatinumDetailConcepts</span>
          </a>
          <p class="brand-desc">
            Premium auto detailing services for car enthusiasts and everyday drivers alike.
            We make your vehicle shine, inside and out.
          </p>
          <div class="social-row">
            {socials.map((s) => (
              <a href={s.href} class="social-icon" aria-label={s.label} set:html={s.icon} />
            ))}
          </div>
          <div class="footer-badge">
            <svg viewBox="0 0 20 20" fill="none"><path d="M10 1l2.39 4.85L18 6.71l-4 3.9.94 5.5L10 13.35 5.06 16.11l.94-5.5L2 6.71l5.61-.86z" fill="#dc2626"/></svg>
            5-Star Rated · Google &amp; Yelp
          </div>
        </div>

        <!-- Link columns -->
        {Object.entries(links).map(([title, items]) => (
          <div class="footer-col">
            <p class="col-title">{title}</p>
            <ul>
              {items.map((item) => (
                <li><a href="#contact">{item}</a></li>
              ))}
            </ul>
          </div>
        ))}

      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {new Date().getFullYear()} PlatinumDetailConcepts Auto Detailing. All rights reserved.</p>
      <div class="footer-legal">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

<style>
.footer {
  background: #050505;
  border-top: 1px solid var(--border);
}

.footer-top { padding: 72px 0 56px; }

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
}

/* Brand */
.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-h);
  font-size: 1.5rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: 16px;
}

.brand-desc {
  font-size: .83rem;
  color: var(--gray);
  line-height: 1.75;
  margin-bottom: 22px;
  max-width: 280px;
}

.social-row {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}
.social-icon {
  width: 36px; height: 36px;
  border: 1px solid var(--border);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray);
  transition: all var(--t);
}
.social-icon:hover { border-color: var(--accent); color: var(--accent); }
.social-icon :global(svg) { width: 16px; height: 16px; }

.footer-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: .72rem;
  color: var(--gray-d);
  letter-spacing: .06em;
}
.footer-badge svg { width: 16px; height: 16px; }

/* Link columns */
.footer-col { padding-top: 4px; }

.col-title {
  font-family: var(--font-h);
  font-size: .85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--white);
  margin-bottom: 18px;
}

.footer-col ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-col ul a {
  font-size: .82rem;
  color: var(--gray);
  transition: color var(--t);
}
.footer-col ul a:hover { color: var(--accent); }

/* Bottom bar */
.footer-bottom {
  padding: 20px 0;
  border-top: 1px solid var(--border);
}
.footer-bottom .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.footer-bottom p {
  font-size: .76rem;
  color: var(--gray-d);
}
.footer-legal {
  display: flex;
  gap: 20px;
}
.footer-legal a {
  font-size: .76rem;
  color: var(--gray-d);
  transition: color var(--t);
}
.footer-legal a:hover { color: var(--accent); }

@media (max-width: 900px) {
  .footer-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .footer-grid { grid-template-columns: 1fr; }
  .footer-bottom .container { flex-direction: column; text-align: center; }
}
</style>
